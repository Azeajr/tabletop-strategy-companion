{
  "name": "tabletop-strategy-companion",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "web-harness serve --dir dist --port 5176",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test",
    "check:ci": "npm run lint && npm run test:coverage && npm run build",
    "harness": "web-harness",
    "smoke": "web-harness smoke",
    "test:e2e:container": "web-harness e2e"
  },
  "dependencies": {
    "@solidjs/router": "^0.16.1",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "@tailwindcss/vite": "^4.3.3",
    "solid-js": "^1.9.14",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@azeajr/web-harness": "github:Azeajr/web-harness#v0.2.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.7",
    "wrangler": "^4.141.0"
  }
